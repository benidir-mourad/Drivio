APP_NAME=Drivio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de donnees PostgreSQL (recommande) via Docker : voir docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=drivio
DB_USERNAME=drivio
DB_PASSWORD=secret

# Alternative MySQL (WAMP/XAMPP)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=drivio
# DB_USERNAME=root
# DB_PASSWORD=

# Sanctum - domaines autorises pour l'auth SPA stateful
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,localhost
FRONTEND_URL=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

# Mail (log en dev, smtp en prod)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@drivio.fr"
MAIL_FROM_NAME="${APP_NAME}"

# SMS (interface abstraite - implémenter SmsServiceInterface)
SMS_DRIVER=log
# SMS_API_KEY=
# SMS_FROM=

VITE_APP_NAME="${APP_NAME}"
